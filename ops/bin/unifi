#!/usr/bin/env python3
"""Read-only UniFi queries against the Bennett-Valley gateway.

Usage: ops/bin/unifi <command> [--json]
  networks       LANs/VLANs with subnet and DHCP pool
  clients        clients online now
  known          every client the gateway has ever seen
  reservations   DHCP fixed-IP reservations
  devices        UniFi devices (gateway, switches, APs)

The API key comes from macOS Keychain (service "unifi-api"). The key can also
write, but this tool only issues GETs; make UniFi changes only when Oren asks.
"""
import json
import os
import ssl
import subprocess
import sys
import urllib.request

HOST = os.environ.get("UNIFI_HOST", "192.168.2.1")
BASE = f"https://{HOST}/proxy/network"
SITE = "default"


def api_key():
    try:
        return subprocess.run(
            ["security", "find-generic-password", "-s", "unifi-api", "-w"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except subprocess.CalledProcessError:
        sys.exit("unifi: no Keychain item 'unifi-api' (see ops/README.md)")


def get(path):
    req = urllib.request.Request(f"{BASE}/{path}", headers={"X-API-KEY": api_key(), "Accept": "application/json"})
    # The gateway uses a self-signed certificate on the LAN.
    ctx = ssl._create_unverified_context()
    with urllib.request.urlopen(req, context=ctx, timeout=15) as r:
        body = json.load(r)
    return body.get("data", body)


def networks():
    nets = {n["_id"]: n for n in get(f"api/s/{SITE}/rest/networkconf")}
    return nets


def rows_networks():
    for n in networks().values():
        if n.get("purpose") == "wan":
            continue
        yield {"name": n.get("name"), "vlan": n.get("vlan") or "", "subnet": n.get("ip_subnet"),
               "dhcp": f'{n.get("dhcpd_start")}-{n.get("dhcpd_stop")}'}


def rows_clients():
    for c in sorted(get(f"api/s/{SITE}/stat/sta"), key=lambda c: ip_key(c.get("ip"))):
        yield {"ip": c.get("ip"), "mac": c["mac"], "name": c.get("name") or c.get("hostname") or "",
               "network": c.get("network", ""), "wired": "wired" if c.get("is_wired") else "wifi",
               "uplink": c.get("last_uplink_name", "")}


def rows_known():
    for u in sorted(get(f"api/s/{SITE}/rest/user"), key=lambda u: ip_key(u.get("fixed_ip") or u.get("last_ip"))):
        yield {"ip": u.get("fixed_ip") or u.get("last_ip") or "", "mac": u["mac"],
               "name": u.get("name") or u.get("hostname") or "", "fixed": "fixed" if u.get("use_fixedip") else "",
               "last_seen": u.get("last_seen") or ""}


def rows_reservations():
    nets = networks()
    for u in sorted(get(f"api/s/{SITE}/rest/user"), key=lambda u: ip_key(u.get("fixed_ip"))):
        if not u.get("use_fixedip"):
            continue
        yield {"ip": u.get("fixed_ip"), "mac": u["mac"], "name": u.get("name") or u.get("hostname") or "",
               "network": nets.get(u.get("network_id"), {}).get("name", "")}


def rows_devices():
    site = get("integration/v1/sites")[0]["id"]
    for d in get(f"integration/v1/sites/{site}/devices?limit=200"):
        yield {"name": d.get("name"), "model": d.get("model"), "ip": d.get("ipAddress"), "state": d.get("state")}


def ip_key(ip):
    try:
        return tuple(int(p) for p in (ip or "").split("."))
    except ValueError:
        return (999,)


COMMANDS = {"networks": rows_networks, "clients": rows_clients, "known": rows_known,
            "reservations": rows_reservations, "devices": rows_devices}

if __name__ == "__main__":
    args = sys.argv[1:]
    if not args or args[0] not in COMMANDS:
        sys.exit(__doc__.strip())
    rows = list(COMMANDS[args[0]]())
    if "--json" in args:
        json.dump(rows, sys.stdout, indent=1)
        print()
    else:
        for r in rows:
            print("\t".join(str(v) for v in r.values()))
