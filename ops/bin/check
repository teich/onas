#!/bin/sh
# Run every guest's check.sh inside that guest, and each common/<name>/check.sh inside its
# targets. Prints problems only; exits 1 if any.
# Usage: ops/bin/check [host] [id-name ...]
set -u

HOST=${WTR_HOST:-root@192.168.2.2}
OPS=$(cd "$(dirname "$0")/.." && pwd)
status=0

all=0
if [ $# -eq 0 ]; then
	all=1
	set -- host $(cd "$OPS/guests" && ls)
fi

for guest in "$@"; do
	if [ "$guest" = host ]; then
		script="$OPS/host/check.sh"
		run=""
	else
		script="$OPS/guests/$guest/check.sh"
		run="pct exec ${guest%%-*} --"
	fi
	[ -f "$script" ] || continue
	out=$(ssh "$HOST" "$run sh -s" < "$script" 2>&1) || {
		status=1
		echo "$out" | sed "s/^/$guest: /"
	}
done

# Shared configs (common/<name>) are checked on every guest in their targets file,
# when checking everything.
[ $all -eq 1 ] && for dir in "$OPS"/common/*/; do
	[ -f "$dir/check.sh" ] && [ -f "$dir/targets" ] || continue
	name=common/$(basename "$dir")
	for target in $(cat "$dir/targets"); do
		out=$(ssh "$HOST" "pct exec ${target%%-*} -- sh -s" < "$dir/check.sh" 2>&1) || {
			status=1
			echo "$out" | sed "s|^|$target ($name): |"
		}
	done
done

[ $status -eq 0 ] && echo "all checks pass"
exit $status
