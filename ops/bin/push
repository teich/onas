#!/bin/sh
# Copy ops/guests/<id-name>/files/ onto that guest's root filesystem.
# Usage: ops/bin/push 101-caddy    (or `push host` for ops/host/ onto WTR itself)
set -eu

HOST=${WTR_HOST:-root@192.168.2.2}
OPS=$(cd "$(dirname "$0")/.." && pwd)
guest=${1:?usage: push <id-name>|host}
if [ "$guest" = host ]; then
	dir="$OPS/host"
	run=""
else
	dir="$OPS/guests/$guest"
	run="pct exec ${guest%%-*} --"
fi

[ -d "$dir/files" ] || { echo "no files/ in $dir" >&2; exit 1; }

COPYFILE_DISABLE=1 tar -C "$dir/files" --uid 0 --gid 0 --no-mac-metadata --no-xattrs -cf - . \
	| ssh "$HOST" "$run tar -xpf - -C / --no-overwrite-dir"
echo "pushed $guest"
