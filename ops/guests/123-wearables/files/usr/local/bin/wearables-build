#!/bin/sh
# Build the backend image the stack runs: upstream Open Wearables at OW_VERSION with our
# patches (/etc/openwearables/patches, in order) applied. A patch that no longer applies
# stops the build, so an upgrade never silently drops or clobbers a change.
set -eu
version=$(sed -n 's/^OW_VERSION=//p' /etc/openwearables/env | tail -n 1)
[ -n "$version" ] || { echo "OW_VERSION not set in /etc/openwearables/env" >&2; exit 1; }
src=/var/lib/openwearables-build/src
rm -rf "$src"
mkdir -p "$(dirname "$src")"
git -c advice.detachedHead=false clone -q --depth 1 --branch "$version" https://github.com/the-momentum/open-wearables.git "$src"
git -C "$src" -c user.name=onas -c user.email=root@wearables am -q /etc/openwearables/patches/*.patch
docker build -q -t "local/open-wearables-backend:$version-onas" \
	--build-arg GIT_SHA="$(git -C "$src" rev-parse --short HEAD)" "$src/backend"
echo "Built local/open-wearables-backend:$version-onas"
