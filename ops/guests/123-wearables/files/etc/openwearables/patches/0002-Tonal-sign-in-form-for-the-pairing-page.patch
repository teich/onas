+from unittest.mock import MagicMock
+from urllib.parse import parse_qs, urlparse
+
+import httpx
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy.orm import Session
+
+from app.api.routes.v1 import oauth as oauth_routes
+from app.models import UserConnection
+from app.schemas.model_crud.credentials import OAuthTokenResponse
+from app.services.providers.tonal import oauth as tonal_oauth
+from app.services.providers.tonal.oauth import TonalOAuth
+from tests.factories import UserFactory
+
+TOKENS = OAuthTokenResponse(access_token="id-token", token_type="Bearer", refresh_token="refresh", expires_in=86400)
+
+
+@pytest.fixture
+def tonal(monkeypatch: pytest.MonkeyPatch) -> dict[str, MagicMock]:
+    """Stand in for Tonal's Auth0 and API, and for Celery."""
+    mocks = {
+        "password_grant": MagicMock(return_value=TOKENS),
+        "email_code_grant": MagicMock(return_value=TOKENS),
+        "send_email_code": MagicMock(),
+        "_get_provider_user_info": MagicMock(return_value={"user_id": "tonal-user", "username": "a@b.c"}),
+    }
+    for name, mock in mocks.items():
+        monkeypatch.setattr(TonalOAuth, name, lambda self, *a, _m=mock: _m(*a))
+    mocks["celery"] = MagicMock()
+    monkeypatch.setattr(oauth_routes, "sync_vendor_data", MagicMock())
+    monkeypatch.setattr(tonal_oauth, "celery_app", mocks["celery"])
+    return mocks
+
+
+def _start(client: TestClient, user_id: str) -> str:
+    """Begin a connect the way the pairing page does; return the state."""
+    response = client.get("/api/v1/oauth/tonal/authorize", params={"user_id": user_id})
+    assert response.status_code == 200
+    url = urlparse(response.json()["authorization_url"])
+    assert url.path == "/api/v1/oauth/tonal/signin"
+    return parse_qs(url.query)["state"][0]
+
+
+def test_form_needs_a_live_state(client: TestClient) -> None:
+    response = client.get("/api/v1/oauth/tonal/signin", params={"state": "nope"})
+    assert response.status_code == 400
+    assert "expired" in response.text
+
+
+def test_password_signin_connects_and_backfills(client: TestClient, db: Session, tonal: dict) -> None:
+    user = UserFactory()
+    state = _start(client, str(user.id))
+    assert 'name="password"' in client.get("/api/v1/oauth/tonal/signin", params={"state": state}).text
+
+    response = client.post(
+        "/api/v1/oauth/tonal/signin",
+        data={"state": state, "email": " a@b.c ", "password": "pw"},
+        follow_redirects=False,
+    )
+    assert response.status_code == 303
+    assert response.headers["location"].startswith("/api/v1/oauth/tonal/callback?code=")
+    tonal["password_grant"].assert_called_once_with("a@b.c", "pw")
+
+    callback = client.get(response.headers["location"], follow_redirects=False)
+    assert callback.status_code in (302, 303, 307)
+
+    connection = db.query(UserConnection).filter_by(user_id=user.id, provider="tonal").one()
+    assert connection.provider_user_id == "tonal-user"
+    assert connection.access_token == "id-token"
+    kwargs = tonal["celery"].send_task.call_args.kwargs["kwargs"]
+    assert kwargs["providers"] == ["tonal"]
+    assert kwargs["is_historical"] is True
+    assert tonal["celery"].send_task.call_args.kwargs["countdown"] == 300
+
+    # The state and the code are one-time
+    assert client.get(response.headers["location"], follow_redirects=False).status_code >= 400
+
+
+def test_empty_password_sends_a_code(client: TestClient, db: Session, tonal: dict) -> None:
+    user = UserFactory()
+    state = _start(client, str(user.id))
+
+    response = client.post("/api/v1/oauth/tonal/signin", data={"state": state, "email": "a@b.c"})
+    assert "Check your email" in response.text
+    tonal["send_email_code"].assert_called_once_with("a@b.c")
+
+    response = client.post(
+        "/api/v1/oauth/tonal/signin",
+        data={"state": state, "email": "a@b.c", "code": "123456"},
+        follow_redirects=False,
+    )
+    assert response.status_code == 303
+    tonal["email_code_grant"].assert_called_once_with("a@b.c", "123456")
+
+
+def test_wrong_password_shows_the_form_again(client: TestClient, db: Session, tonal: dict) -> None:
+    user = UserFactory()
+    state = _start(client, str(user.id))
+    rejected = httpx.Response(403, request=httpx.Request("POST", "https://tonal.auth0.com/oauth/token"))
+    tonal["password_grant"].side_effect = httpx.HTTPStatusError("no", request=rejected.request, response=rejected)
+
+    response = client.post("/api/v1/oauth/tonal/signin", data={"state": state, "email": "a@b.c", "password": "x"})
+
+    assert response.status_code == 200
+    assert "accept that email and password" in response.text
+    assert 'value="a@b.c"' in response.text
+    assert db.query(UserConnection).filter_by(user_id=user.id, provider="tonal").count() == 0
