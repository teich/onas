             connected_at=datetime.now(timezone.utc).isoformat(),
         )
         return user_info["user_id"] or ""
+
+
+def queue_backfill(user_id: UUID, days: int = BACKFILL_DAYS, countdown: int = BACKFILL_DELAY_SECONDS) -> None:
+    """Queue a historical pull, as the portal's historical sync does (it leaves the live cursor alone)."""
+    end = datetime.now(timezone.utc)
+    celery_app.send_task(
+        CeleryTask.SYNC_VENDOR_DATA,
+        kwargs={
+            "user_id": str(user_id),
+            "start_date": (end - timedelta(days=days)).isoformat(),
+            "end_date": end.isoformat(),
+            "providers": ["tonal"],
+            "is_historical": True,
+        },
+        countdown=countdown,
+    )
diff --git a/backend/app/services/providers/tonal/signin.py b/backend/app/services/providers/tonal/signin.py
new file mode 100644
index 00000000..ee5f03d9
--- /dev/null
+++ b/backend/app/services/providers/tonal/signin.py
@@ -0,0 +1,126 @@
+"""The sign-in form that stands in for Tonal's login page (see oauth.py).
+
+GET  /api/v1/oauth/tonal/signin?state=...  the form, reached from /oauth/tonal/authorize
+POST /api/v1/oauth/tonal/signin            signs in, then redirects to the normal callback
+
+Leave the password empty to get a code by email instead. The password goes to Tonal's
+Auth0 once and is never stored or logged; only the resulting tokens are kept.
+"""
+
+from html import escape
+from typing import Annotated
+from urllib.parse import urlencode
+
+import httpx
+from fastapi import APIRouter, Form, Query
+from fastapi.responses import HTMLResponse, RedirectResponse
+from starlette.concurrency import run_in_threadpool
+
+from app.schemas.model_crud.credentials import OAuthTokenResponse
+from app.services.providers.tonal.strategy import TonalStrategy
+
+router = APIRouter()
+
+PAGE = """<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Connect Tonal</title>
+<style>
+:root {{ color-scheme: light dark; --fg: #111; --muted: #666; --bg: #f6f6f4; --card: #fff; --line: #ddd;
+  --err: #b42318; }}
+@media (prefers-color-scheme: dark) {{
+  :root {{ --fg: #eee; --muted: #999; --bg: #151515; --card: #1f1f1f; --line: #333; --err: #f97066; }}
+}}
+body {{ margin: 0; font: 16px/1.45 system-ui, sans-serif; background: var(--bg); color: var(--fg); }}
+main {{ max-width: 380px; margin: 10vh auto; padding: 0 16px; }}
+form {{ background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 24px; }}
+h1 {{ font-size: 20px; margin: 0 0 4px; }}
+p {{ color: var(--muted); margin: 0 0 16px; font-size: 14px; }}
+label {{ display: block; font-size: 14px; margin: 12px 0 4px; }}
+input {{ width: 100%; box-sizing: border-box; padding: 10px; font: inherit; border: 1px solid var(--line);
+  border-radius: 8px; background: transparent; color: inherit; }}
+button {{ width: 100%; margin-top: 20px; padding: 11px; font: inherit; font-weight: 600; border: 0; border-radius: 8px;
+  background: var(--fg); color: var(--bg); cursor: pointer; }}
+.err {{ color: var(--err); }}
+</style></head>
+<body><main>{body}</main></body></html>"""
+
+
+def _page(body: str, status_code: int = 200) -> HTMLResponse:
+    return HTMLResponse(PAGE.format(body=body), status_code=status_code)
+
+
+def _error(message: str) -> str:
+    return f'<p class="err">{escape(message)}</p>' if message else ""
+
+
+def _credentials_form(state: str, email: str = "", message: str = "") -> HTMLResponse:
+    return _page(f"""<form method="post">
+<h1>Connect your Tonal account</h1>
+<p>Sign in with your Tonal account. Your password is used once to sign in and isn't stored.
+Leave it empty and we'll email you a code instead.</p>{_error(message)}
+<input type="hidden" name="state" value="{escape(state)}">
+<label for="email">Tonal email</label>
+<input id="email" name="email" type="email" autocomplete="username" required value="{escape(email)}" autofocus>
+<label for="password">Password</label>
+<input id="password" name="password" type="password" autocomplete="current-password">
+<button type="submit">Connect</button>
+</form>""")
+
+
+def _code_form(state: str, email: str, message: str = "") -> HTMLResponse:
+    return _page(f"""<form method="post">
+<h1>Check your email</h1>
+<p>Tonal sent a code to {escape(email)}.</p>{_error(message)}
+<input type="hidden" name="state" value="{escape(state)}">
+<input type="hidden" name="email" value="{escape(email)}">
+<label for="code">Code</label>
+<input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" required autofocus>
+<button type="submit">Connect</button>
+</form>""")
+
+
+def _expired() -> HTMLResponse:
+    return _page(
+        "<form><h1>This link has expired</h1><p>Go back and choose Tonal again to get a fresh sign-in.</p></form>",
+        status_code=400,
+    )
+
+
+@router.get("/signin", include_in_schema=False)
+def signin_form(state: Annotated[str, Query()] = "") -> HTMLResponse:
+    if not TonalStrategy().oauth.state_is_pending(state):
+        return _expired()
+    return _credentials_form(state)
+
+
+@router.post("/signin", include_in_schema=False, response_model=None)
+async def signin(
+    state: Annotated[str, Form()] = "",
+    email: Annotated[str, Form()] = "",
+    password: Annotated[str, Form()] = "",
+    code: Annotated[str, Form()] = "",
+) -> HTMLResponse | RedirectResponse:
+    oauth = TonalStrategy().oauth
+    if not oauth.state_is_pending(state):
+        return _expired()
+    email = email.strip()
+
+    try:
+        if code:
+            tokens: OAuthTokenResponse = await run_in_threadpool(oauth.email_code_grant, email, code.strip())
+        elif password:
+            tokens = await run_in_threadpool(oauth.password_grant, email, password)
+        else:
+            await run_in_threadpool(oauth.send_email_code, email)
+            return _code_form(state, email)
+    except httpx.HTTPStatusError as e:
+        if e.response.status_code in (400, 401, 403):
+            if code:
+                return _code_form(state, email, "That code didn't work. Check it and try again.")
+            return _credentials_form(state, email, "Tonal didn't accept that email and password.")
+        return _credentials_form(state, email, "Tonal's sign-in isn't answering. Try again in a moment.")
+    except httpx.HTTPError:
+        return _credentials_form(state, email, "Tonal's sign-in isn't answering. Try again in a moment.")
+
+    query = urlencode({"code": oauth.issue_code(tokens), "state": state})
+    return RedirectResponse(f"/api/v1/oauth/tonal/callback?{query}", status_code=303)
