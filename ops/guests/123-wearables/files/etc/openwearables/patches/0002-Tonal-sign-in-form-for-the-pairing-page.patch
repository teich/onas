 from app.schemas.model_crud.credentials import OAuthState, OAuthTokenResponse, ProviderCredentials, ProviderEndpoints
@@ -26,6 +36,12 @@ logger = logging.getLogger(__name__)
 AUTH0_URL = "https://tonal.auth0.com"
 CLIENT_ID = "ERCyexW-xoVG_Yy3RDe-eV4xsOnRHP6L"
 SCOPE = "openid profile email offline_access"
+SIGNIN_PATH = "/api/v1/oauth/tonal/signin"
+CODE_TTL_SECONDS = 120
+BACKFILL_DAYS = 400  # Oren's history starts 2025-12; Tonal has no known limit
+# The callback itself queues a 90-day historical sync on connect (HISTORICAL_SYNC_ON_CONNECT), and a
+# second pull of the same account while one runs is skipped, so the long one waits for it to finish.
+BACKFILL_DELAY_SECONDS = 300
 
 
 class TonalOAuth(BaseOAuthTemplate):
@@ -41,11 +57,31 @@ class TonalOAuth(BaseOAuthTemplate):
 
     auth_method: AuthenticationMethod = AuthenticationMethod.BODY
 
-    def get_authorization_url(self, user_id: UUID, redirect_uri: str | None = None) -> tuple[str, str]:
-        raise HTTPException(
-            status_code=HTTP_400_BAD_REQUEST,
-            detail="Tonal has no browser sign-in for other apps; connect with app.services.providers.tonal.connect",
-        )
+    def _build_auth_url(self, state: str) -> tuple[str, dict[str, Any] | None]:
+        return f"{settings.api_base_url}{SIGNIN_PATH}?state={state}", None
+
+    def state_is_pending(self, state: str) -> bool:
+        """True while a connect started by /authorize is waiting for its sign-in (not consumed)."""
+        return bool(state) and bool(self.redis_client.exists(f"oauth_state:{state}"))
+
+    def issue_code(self, token_response: OAuthTokenResponse) -> str:
+        """Park signed-in tokens under a one-time code for the callback to redeem."""
+        code = secrets.token_urlsafe(32)
+        self.redis_client.setex(f"tonal_signin:{code}", CODE_TTL_SECONDS, token_response.model_dump_json())
+        return code
+
+    def _exchange_token(self, code: str, code_verifier: str | None) -> OAuthTokenResponse:
+        key = f"tonal_signin:{code}"
+        data = self.redis_client.get(key)
+        self.redis_client.delete(key)
+        if not data:
+            raise HTTPException(status_code=HTTP_400_BAD_REQUEST, detail="Tonal sign-in expired; start again")
+        return OAuthTokenResponse.model_validate(json.loads(data))
+
+    def handle_callback(self, db: DbSession, code: str, state: str) -> OAuthState:
+        oauth_state = super().handle_callback(db, code, state)
+        queue_backfill(oauth_state.user_id)
+        return oauth_state
 
     def _token_request(self, body: dict) -> OAuthTokenResponse:
         response = httpx.post(self.endpoints.token_url, json={"client_id": CLIENT_ID, **body}, timeout=30.0)
