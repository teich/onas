diff --git a/backend/app/services/providers/tonal/oauth.py b/backend/app/services/providers/tonal/oauth.py
new file mode 100644
index 00000000..2a605b1b
--- /dev/null
+++ b/backend/app/services/providers/tonal/oauth.py
@@ -0,0 +1,143 @@
+"""Tonal sign-in through its Auth0 tenant, using the Tonal mobile app's public client.
+
+Tonal has no developer OAuth: its Auth0 client only accepts the app's own redirect URI,
+so the browser connect flow can't work. A connection is created once with the
+password or email-code grant (see connect.py) and kept alive with the refresh token.
+Tonal's API takes the Auth0 *id_token* as its bearer, so that is what we store as the
+access token.
+"""
+
+import logging
+from datetime import datetime, timezone
+from uuid import UUID
+
+import httpx
+from fastapi import HTTPException
+from starlette.status import HTTP_400_BAD_REQUEST, HTTP_401_UNAUTHORIZED
+
+from app.database import DbSession
+from app.schemas.auth import AuthenticationMethod
+from app.schemas.model_crud.credentials import OAuthState, OAuthTokenResponse, ProviderCredentials, ProviderEndpoints
+from app.services.providers.templates.base_oauth import BaseOAuthTemplate
+from app.utils.structured_logging import log_structured
+
+logger = logging.getLogger(__name__)
+
+AUTH0_URL = "https://tonal.auth0.com"
+CLIENT_ID = "ERCyexW-xoVG_Yy3RDe-eV4xsOnRHP6L"
+SCOPE = "openid profile email offline_access"
+
+
+class TonalOAuth(BaseOAuthTemplate):
+    """Auth0 token handling for Tonal."""
+
+    @property
+    def endpoints(self) -> ProviderEndpoints:
+        return ProviderEndpoints(authorize_url=f"{AUTH0_URL}/authorize", token_url=f"{AUTH0_URL}/oauth/token")
+
+    @property
+    def credentials(self) -> ProviderCredentials:
+        return ProviderCredentials(client_id=CLIENT_ID, client_secret="", redirect_uri="", default_scope=SCOPE)
+
+    auth_method: AuthenticationMethod = AuthenticationMethod.BODY
+
+    def get_authorization_url(self, user_id: UUID, redirect_uri: str | None = None) -> tuple[str, str]:
+        raise HTTPException(
+            status_code=HTTP_400_BAD_REQUEST,
+            detail="Tonal has no browser sign-in for other apps; connect with app.services.providers.tonal.connect",
+        )
+
+    def _token_request(self, body: dict) -> OAuthTokenResponse:
+        response = httpx.post(self.endpoints.token_url, json={"client_id": CLIENT_ID, **body}, timeout=30.0)
+        response.raise_for_status()
+        data = response.json()
+        return OAuthTokenResponse(
+            access_token=data["id_token"],
+            token_type=data.get("token_type", "Bearer"),
+            refresh_token=data.get("refresh_token"),
+            expires_in=data.get("expires_in", 36000),
+            scope=data.get("scope"),
+        )
+
+    def password_grant(self, email: str, password: str) -> OAuthTokenResponse:
+        return self._token_request({"grant_type": "password", "username": email, "password": password, "scope": SCOPE})
+
+    def send_email_code(self, email: str) -> None:
+        response = httpx.post(
+            f"{AUTH0_URL}/passwordless/start",
+            json={"client_id": CLIENT_ID, "connection": "email", "email": email, "send": "code"},
+            timeout=30.0,
+        )
+        response.raise_for_status()
+
+    def email_code_grant(self, email: str, code: str) -> OAuthTokenResponse:
+        return self._token_request(
+            {
+                "grant_type": "http://auth0.com/oauth/grant-type/passwordless/otp",
+                "username": email,
+                "otp": code,
+                "realm": "email",
+                "scope": SCOPE,
+            }
+        )
+
+    def refresh_access_token(
+        self, db: DbSession, user_id: UUID, refresh_token: str, *, revoke_on_failure: bool = True
+    ) -> OAuthTokenResponse:
+        try:
+            token_response = self._token_request({"grant_type": "refresh_token", "refresh_token": refresh_token})
+        except httpx.HTTPStatusError as e:
+            log_structured(
+                logger,
+                "error",
+                f"Failed to refresh Tonal token: {e.response.text}",
+                provider=self.provider_name,
+                task="refresh_access_token",
+                user_id=str(user_id),
+                status_code=e.response.status_code,
+            )
+            if e.response.status_code in (HTTP_400_BAD_REQUEST, HTTP_401_UNAUTHORIZED, 403):
+                if revoke_on_failure:
+                    self._revoke_connection(db, user_id, reason="refresh_failed")
+                raise HTTPException(
+                    status_code=HTTP_401_UNAUTHORIZED, detail="Tonal refresh token rejected; reconnection required"
+                )
+            raise
+
+        connection = self.connection_repo.get_by_user_and_provider(db, user_id, self.provider_name)
+        if connection:
+            # Tonal rotates refresh tokens, so the new one must be kept.
+            self.connection_repo.update_tokens(
+                db,
+                connection,
+                token_response.access_token,
+                token_response.refresh_token or refresh_token,
+                token_response.expires_in,
+            )
+        return token_response
+
+    def _get_provider_user_info(self, token_response: OAuthTokenResponse, user_id: str) -> dict[str, str | None]:
+        response = httpx.get(
+            "https://api.tonal.com/v6/users/userinfo",
+            headers={"Authorization": f"Bearer {token_response.access_token}"},
+            timeout=30.0,
+        )
+        response.raise_for_status()
+        data = response.json()
+        return {"user_id": data["id"], "username": data.get("email")}
+
+    def save_connection(self, db: DbSession, user_id: UUID, token_response: OAuthTokenResponse) -> str:
+        """Create or update the user's Tonal connection. Returns the Tonal user id."""
+        user_info = self._get_provider_user_info(token_response, str(user_id))
+        oauth_state = OAuthState(user_id=user_id, provider=self.provider_name)
+        self._save_connection(db, user_id, token_response, user_info, oauth_state)
+        log_structured(
+            logger,
+            "info",
+            "Tonal connection saved",
+            provider=self.provider_name,
+            task="save_connection",
+            user_id=str(user_id),
+            connected_at=datetime.now(timezone.utc).isoformat(),
+        )
+        return user_info["user_id"] or ""
