+from app.services.providers.base_strategy import BaseProviderStrategy, ProviderCapabilities, ProviderCoverage
+from app.services.providers.tonal.coverage import HEALTH_SCORES, SLEEP_FIELDS, TIMESERIES, WORKOUT_FIELDS
+from app.services.providers.tonal.oauth import TonalOAuth
+from app.services.providers.tonal.workouts import TonalWorkouts
+
+
+class TonalStrategy(BaseProviderStrategy):
+    """Tonal provider, on Tonal's unofficial API. Pull only: Tonal has no webhooks."""
+
+    def __init__(self):
+        super().__init__()
+
+        self.oauth = TonalOAuth(
+            user_repo=self.user_repo,
+            connection_repo=self.connection_repo,
+            provider_name=self.name,
+            api_base_url=self.api_base_url,
+        )
+
+        self.workouts = TonalWorkouts(
+            workout_repo=self.workout_repo,
+            connection_repo=self.connection_repo,
+            provider_name=self.name,
+            api_base_url=self.api_base_url,
+            oauth=self.oauth,
+        )
+
+    @property
+    def name(self) -> str:
+        return "tonal"
+
+    @property
+    def api_base_url(self) -> str:
+        return "https://api.tonal.com"
+
+    @property
+    def coverage(self) -> ProviderCoverage:
+        return ProviderCoverage(
+            timeseries=TIMESERIES,
+            workout_fields=WORKOUT_FIELDS,
+            sleep_fields=SLEEP_FIELDS,
+            health_scores=HEALTH_SCORES,
+        )
+
+    @property
+    def capabilities(self) -> ProviderCapabilities:
+        return ProviderCapabilities(rest_pull=True)
diff --git a/backend/app/services/providers/tonal/workouts.py b/backend/app/services/providers/tonal/workouts.py
new file mode 100644
index 00000000..90ca0447
--- /dev/null
+++ b/backend/app/services/providers/tonal/workouts.py
@@ -0,0 +1,292 @@
+"""Tonal workouts and strength scores.
+
+Each sync lists the workout activities in the window, fetches each one's formatted
+summary (title, program, heart rate, calories and per-movement sets with names), and
+saves the strength score history for the same window as health scores linked to the
+workout that changed them.
+
+Tonal's API is unofficial: field names come from tonal-api and toneget and were
+checked against Oren's account on 2026-10-24.
+"""
+
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+from typing import Any
+from uuid import UUID, uuid4
+
+import httpx
+
+from app.config import settings
+from app.database import DbSession
+from app.schemas.enums import HealthScoreCategory, ProviderName, WorkoutType
+from app.schemas.model_crud.activities import (
+    EventRecordCreate,
+    EventRecordDetailCreate,
+    HealthScoreCreate,
+    ScoreComponent,
+)
+from app.services.event_record_service import event_record_service
+from app.services.health_score_service import health_score_service
+from app.services.providers.api_client import get_valid_token
+from app.services.providers.templates.base_workouts import BaseWorkoutsTemplate
+from app.services.providers.tonal.coverage import TRAINING_TYPE_TO_WORKOUT_TYPE
+from app.services.raw_payload_storage import store_raw_payload
+from app.utils.structured_logging import log_structured
+
+PAGE_SIZE = 100  # Tonal's maximum pg-limit
+DEFAULT_DAYS = 30
+
+# health_score.value is numeric(6,3) and Tonal scores pass 1,000, so the headline value
+# is the overall score divided by 10 (qualifier "x10"). The real scores are in components.
+SCORE_SCALE = 10
+
+
+def _parse_dt(value: Any) -> datetime | None:
+    if value is None or isinstance(value, datetime):
+        return value
+    return datetime.fromisoformat(str(value).replace("Z", "+00:00"))
+
+
+def _num(value: Any) -> Decimal | None:
+    return None if value in (None, "", 0) else Decimal(str(round(float(value), 3)))
+
+
+class TonalWorkouts(BaseWorkoutsTemplate):
+    """Pull Tonal workouts and strength scores."""
+
+    def _request(
+        self, db: DbSession, user_id: UUID, endpoint: str, headers: dict[str, str] | None = None, **params: Any
+    ) -> tuple[Any, httpx.Headers]:
+        """GET that also returns the response headers, which carry Tonal's paging (pg-total)."""
+        token = get_valid_token(db, user_id, self.provider_name, self.connection_repo, self.oauth)
+        response = httpx.get(
+            f"{self.api_base_url}{endpoint}",
+            headers={"Authorization": f"Bearer {token}", "Accept": "application/json", **(headers or {})},
+            params=params,
+            timeout=settings.provider_request_timeout_seconds,
+        )
+        response.raise_for_status()
+        return response.json(), response.headers
+
+    def _tonal_user_id(self, db: DbSession, user_id: UUID) -> str:
+        connection = self.connection_repo.get_by_user_and_provider(db, user_id, self.provider_name)
+        if not connection or not connection.provider_user_id:
+            raise ValueError("Tonal connection has no Tonal user id; reconnect with the connect script")
+        return connection.provider_user_id
+
+    def get_workouts(self, db: DbSession, user_id: UUID, start_date: datetime, end_date: datetime) -> list[Any]:
+        """Workout activities that began in [start_date, end_date), oldest first.
+
+        The list is sorted oldest first and paged by offset, so read the total and walk
+        back from the newest page until a page starts before the window.
+        """
+        endpoint = f"/v6/users/{self._tonal_user_id(db, user_id)}/workout-activities"
+        _, headers = self._request(db, user_id, endpoint, {"pg-offset": "0", "pg-limit": "1"})
+        offset = int(headers.get("pg-total", 0))
+
+        found: list[dict] = []
+        while offset > 0:
+            page_offset = max(offset - PAGE_SIZE, 0)
+            page, _ = self._request(
+                db, user_id, endpoint, {"pg-offset": str(page_offset), "pg-limit": str(offset - page_offset)}
+            )
+            offset = page_offset
+            for activity in page:
+                begin = _parse_dt(activity["beginTime"])
+                if not activity.get("deletedAt") and begin and start_date <= begin < end_date:
+                    found.append(activity)
+            if not page or min(_parse_dt(a["beginTime"]) for a in page) < start_date:
+                break
+        return sorted(found, key=lambda a: a["beginTime"])
+
+    def get_workouts_from_api(self, db: DbSession, user_id: UUID, **kwargs: Any) -> Any:
+        start = _parse_dt(kwargs.get("start_date")) or datetime.now(timezone.utc) - timedelta(days=DEFAULT_DAYS)
+        end = _parse_dt(kwargs.get("end_date")) or datetime.now(timezone.utc)
+        return self.get_workouts(db, user_id, start, end)
+
+    def get_workout_detail_from_api(self, db: DbSession, user_id: UUID, workout_id: str, **kwargs: Any) -> Any:
+        tonal_user_id = self._tonal_user_id(db, user_id)
+        return self._make_api_request(
+            db, user_id, f"/v6/formatted/users/{tonal_user_id}/workout-summaries/{workout_id}"
+        )
+
+    def _normalize_workout(
+        self, raw_workout: tuple[dict, dict], user_id: UUID
+    ) -> tuple[EventRecordCreate, EventRecordDetailCreate]:
+        """raw_workout is (workout activity, formatted summary)."""
+        activity, summary = raw_workout
+        start = _parse_dt(activity["beginTime"])
+        end = _parse_dt(activity.get("endTime") or summary.get("endTime"))
+        if end is None or end <= start:
+            end = start + timedelta(seconds=activity.get("totalDuration") or 0)
+        local = _parse_dt(summary.get("localTimestamp"))
+        zone_offset = local.strftime("%z") if local and local.tzinfo else None
+        if zone_offset:
+            zone_offset = f"{zone_offset[:3]}:{zone_offset[3:]}"
+
+        training_type = (summary.get("primaryTrainingTypeName") or "").lower()
+        workout_type = TRAINING_TYPE_TO_WORKOUT_TYPE.get(training_type, WorkoutType.STRENGTH_TRAINING)
+
+        record_id = uuid4()
+        record = EventRecordCreate(
+            id=record_id,
+            category="workout",
+            type=workout_type.value,
+            source_name="Tonal",
+            device_model="Tonal",
+            duration_seconds=int(activity.get("totalDuration") or (end - start).total_seconds()),
+            start_datetime=start,
+            end_datetime=end,
+            zone_offset=zone_offset,
+            external_id=activity["id"],
+            source=self.provider_name,
+            provider=self.provider_name,
+            user_id=user_id,
+            software_version=activity.get("appVersion"),
+            device_id=activity.get("deviceId"),
+        )
+
+        heart_rate = summary.get("workoutHeartRate") or {}
+        calories = {c.get("algorithm"): c.get("caloriesBurned") for c in summary.get("calories") or []}
+        name, program = summary.get("name"), summary.get("programName")
+        detail = EventRecordDetailCreate(
+            record_id=record_id,
+            heart_rate_min=heart_rate.get("minHeartRate") or None,
+            heart_rate_max=heart_rate.get("maxHeartRate") or None,
+            heart_rate_avg=_num(heart_rate.get("avgHeartRate")),
+            energy_burned=_num(calories.get("AppleWatch") or calories.get("Tonal")),
+            moving_time_seconds=activity.get("activeDuration") or summary.get("timeUnderTension"),
+            label=f"{program}: {name}" if program and name else name,
+            segments=self._build_segments(activity, summary),
+        )
+        return record, detail
+
+    @staticmethod
+    def _build_segments(activity: dict, summary: dict) -> list[dict]:
+        """One segment per movement, with its sets. Weights in lb, power in W, ROM in inches."""
+        raw_sets = {s["id"]: s for s in activity.get("workoutSetActivity") or []}
+        segments = []
+        for movement in summary.get("movementSets") or []:
+            sets = []
+            for s in movement.get("sets") or []:
+                raw = next((raw_sets[i] for i in s.get("associatedSetActivityIds") or [] if i in raw_sets), {})
+                sets.append(
+                    {
+                        "start": s.get("beginTime"),
+                        "duration_s": s.get("duration"),
+                        "reps": s.get("repCount"),
+                        "rep_goal": s.get("repGoal"),
+                        "weight_lb": s.get("weight"),
+                        "one_rep_max_lb": s.get("oneRepMax"),
+                        "max_power_w": s.get("maxConPower"),
+                        "volume_lb": s.get("totalVolume"),
+                        "warm_up": s.get("warmUp"),
+                        "weight_percentage": s.get("weightPercentage"),
+                        "spotter": s.get("spotterMode"),
+                        "burnout": s.get("burnout"),
+                        "drop_set": s.get("dropSet"),
+                        "suggested_weight_change": s.get("suggestedWeightChange"),
+                        "rom_in": raw.get("rom"),
+                        "struggling": raw.get("strugglingScore"),
+                        "reps_in_reserve": raw.get("repsInReserve"),
+                        "side": raw.get("movementSide"),
+                    }
+                )
+            segments.append(
+                {
+                    "type": "movement",
+                    "movement": movement.get("movementName"),
+                    "movement_id": movement.get("movementId"),
+                    "block": movement.get("blockNumber"),
+                    "reps": movement.get("reps"),
+                    "volume_lb": movement.get("totalVolume"),
+                    "work": movement.get("totalWork"),
+                    "avg_weight_lb": movement.get("avgWeight"),
+                    "sets": sets,
+                }
+            )
+        return segments
+
+    def _strength_scores(
+        self, db: DbSession, user_id: UUID, start_date: datetime, end_date: datetime, record_ids: dict[str, UUID]
+    ) -> list[HealthScoreCreate]:
+        tonal_user_id = self._tonal_user_id(db, user_id)
+        history = self._make_api_request(
+            db,
+            user_id,
+            f"/v6/users/{tonal_user_id}/strength-scores/history",
+            params={"limit": 5000, "endDate": (end_date + timedelta(days=1)).date().isoformat()},
+        )
+        scores = []
+        for entry in history or []:
+            recorded_at = _parse_dt(entry.get("activityTime"))
+            if not recorded_at or not start_date <= recorded_at < end_date or entry.get("overall") is None:
+                continue
+            activity_id = entry.get("workoutActivityId")
+            record_id = record_ids.get(activity_id)
+            if record_id is None and activity_id:
+                existing = self.workout_repo.get_by_external_id(db, user_id, activity_id, provider=self.provider_name)
+                record_id = existing.id if existing else None
+            offset = recorded_at.strftime("%z")
+            scores.append(
+                HealthScoreCreate(
+                    id=uuid4(),
+                    user_id=user_id,
+                    provider=ProviderName.TONAL,
+                    category=HealthScoreCategory.STRENGTH,
+                    value=entry["overall"] / SCORE_SCALE,
+                    qualifier=f"x{SCORE_SCALE}",
+                    recorded_at=recorded_at,
+                    zone_offset=f"{offset[:3]}:{offset[3:]}" if offset else None,
+                    components={
+                        k: ScoreComponent(value=entry[k]) for k in ("overall", "upper", "lower", "core") if k in entry
+                    },
+                    event_record_id=record_id,
+                )
+            )
+        return scores
+
+    def load_data(self, db: DbSession, user_id: UUID, **kwargs: Any) -> int:
+        """Sync workouts and strength scores in the window. Returns the number of workouts written."""
+        now = datetime.now(timezone.utc)
+        start = _parse_dt(kwargs.get("start_date") or kwargs.get("start")) or now - timedelta(days=DEFAULT_DAYS)
+        end = _parse_dt(kwargs.get("end_date") or kwargs.get("end")) or now
+        start = start if start.tzinfo else start.replace(tzinfo=timezone.utc)
+        end = end if end.tzinfo else end.replace(tzinfo=timezone.utc)
+
+        activities = self.get_workouts(db, user_id, start, end)
+        record_ids: dict[str, UUID] = {}
+        for activity in activities:
+            summary = self.get_workout_detail_from_api(db, user_id, activity["id"])
+            store_raw_payload(
+                source="api_response",
+                provider=self.provider_name,
+                payload={"activity": activity, "summary": summary},
+                user_id=str(user_id),
+                trace_id="/v6/workout-activities",
+            )
+            record, detail = self._normalize_workout((activity, summary), user_id)
+            created = event_record_service.create(db, record)
+            event_record_service.create_detail(db, detail.model_copy(update={"record_id": created.id}))
+            record_ids[activity["id"]] = created.id
+
+        scores = self._strength_scores(db, user_id, start, end, record_ids)
+        if scores:
+            try:
+                health_score_service.bulk_create(db, scores)
+                db.commit()
+            except Exception:
+                db.rollback()
+                raise
+
+        log_structured(
+            self.logger,
+            "info",
+            "Tonal sync finished",
+            provider=self.provider_name,
+            task="load_data",
+            user_id=str(user_id),
+            workouts=len(activities),
+            strength_scores=len(scores),
+        )
+        return len(activities)
