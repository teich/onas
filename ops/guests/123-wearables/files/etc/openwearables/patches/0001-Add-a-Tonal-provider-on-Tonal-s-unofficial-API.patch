+from collections.abc import Callable
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+from typing import Any
+from unittest.mock import MagicMock
+from uuid import uuid4
+
+import httpx
+import pytest
+
+from app.schemas.enums import HealthScoreCategory, ProviderName, WorkoutType
+from app.services.providers.tonal.strategy import TonalStrategy
+from app.services.providers.tonal.workouts import TonalWorkouts
+
+START = datetime(2026, 10, 23, 17, 27, 6, tzinfo=timezone.utc)
+
+ACTIVITY = {
+    "id": "act-1",
+    "deletedAt": None,
+    "beginTime": "2026-10-23T17:27:06.601151Z",
+    "endTime": "2026-10-23T18:11:32.142172Z",
+    "totalDuration": 2665,
+    "activeDuration": 742,
+    "deviceId": "dev-1",
+    "appVersion": "26.40.0",
+    "workoutSetActivity": [{"id": "set-1", "rom": 30.5, "strugglingScore": 0.7, "repsInReserve": 2.1}],
+}
+
+SUMMARY = {
+    "name": "WO33 (W9D1)",
+    "programName": "12 Weeks to Unleash",
+    "localTimestamp": "2026-10-23T10:27:06.601151-07:00",
+    "primaryTrainingTypeName": "Strength",
+    "workoutHeartRate": {"avgHeartRate": 120, "minHeartRate": 67, "maxHeartRate": 158},
+    "calories": [{"algorithm": "AppleWatch", "caloriesBurned": 311}, {"algorithm": "Tonal", "caloriesBurned": 199.5}],
+    "movementSets": [
+        {
+            "movementName": "Barbell Seated Overhead Press",
+            "movementId": "mov-1",
+            "reps": 38,
+            "totalVolume": 1580,
+            "sets": [{"repCount": 6, "weight": 19, "oneRepMax": 22, "associatedSetActivityIds": ["set-1"]}],
+        }
+    ],
+}
+
+
+@pytest.fixture
+def workouts() -> TonalWorkouts:
+    return TonalStrategy().workouts
+
+
+def test_normalize_workout(workouts: TonalWorkouts) -> None:
+    user_id = uuid4()
+    record, detail = workouts._normalize_workout((ACTIVITY, SUMMARY), user_id)
+
+    assert record.type == WorkoutType.STRENGTH_TRAINING.value
+    assert record.external_id == "act-1"
+    assert record.source == record.provider == "tonal"
+    assert record.duration_seconds == 2665
+    assert record.zone_offset == "-07:00"
+    assert detail.label == "12 Weeks to Unleash: WO33 (W9D1)"
+    assert detail.heart_rate_avg == Decimal("120")
+    assert detail.energy_burned == Decimal("311")
+    segment = detail.segments[0]
+    assert segment["movement"] == "Barbell Seated Overhead Press"
+    assert segment["sets"][0]["weight_lb"] == 19
+    assert segment["sets"][0]["rom_in"] == 30.5
+
+
+def test_unknown_training_type_is_strength(workouts: TonalWorkouts) -> None:
+    record, _ = workouts._normalize_workout((ACTIVITY, {**SUMMARY, "primaryTrainingTypeName": "New"}), uuid4())
+    assert record.type == WorkoutType.STRENGTH_TRAINING.value
+
+
+def test_mobility_is_stretching(workouts: TonalWorkouts) -> None:
+    record, _ = workouts._normalize_workout((ACTIVITY, {**SUMMARY, "primaryTrainingTypeName": "Mobility"}), uuid4())
+    assert record.type == WorkoutType.STRETCHING.value
+
+
+def _activities(n: int) -> list[dict]:
+    """n activities a day apart, oldest first, ending at START."""
+    return [
+        {"id": f"a{i}", "beginTime": (START - timedelta(days=n - 1 - i)).isoformat(), "deletedAt": None}
+        for i in range(n)
+    ]
+
+
+def _fake_request(all_activities: list[dict]) -> tuple[Callable[..., Any], list[tuple[int, int]]]:
+    calls: list[tuple[int, int]] = []
+
+    def request(db: Any, user_id: Any, endpoint: str, headers: dict[str, str], **params: Any) -> Any:
+        offset, limit = int(headers["pg-offset"]), int(headers["pg-limit"])
+        calls.append((offset, limit))
+        return all_activities[offset : offset + limit], httpx.Headers({"pg-total": str(len(all_activities))})
+
+    return request, calls
+
+
+def test_get_workouts_reads_only_the_newest_pages(workouts: TonalWorkouts, monkeypatch: pytest.MonkeyPatch) -> None:
+    request, calls = _fake_request(_activities(250))
+    monkeypatch.setattr(workouts, "_request", request)
+    monkeypatch.setattr(workouts, "_tonal_user_id", lambda db, user_id: "tonal-user")
+
+    found = workouts.get_workouts(MagicMock(), uuid4(), START - timedelta(days=2), START + timedelta(seconds=1))
+
+    assert [a["id"] for a in found] == ["a247", "a248", "a249"]
+    assert calls == [(0, 1), (150, 100)]
+
+
+def test_get_workouts_reads_everything_without_overlap(
+    workouts: TonalWorkouts, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    request, calls = _fake_request(_activities(250))
+    monkeypatch.setattr(workouts, "_request", request)
+    monkeypatch.setattr(workouts, "_tonal_user_id", lambda db, user_id: "tonal-user")
+
+    found = workouts.get_workouts(MagicMock(), uuid4(), START - timedelta(days=1000), START + timedelta(days=1))
+
+    assert len(found) == 250
+    assert calls == [(0, 1), (150, 100), (50, 100), (0, 50)]
+
+
+def test_strength_scores_scaled_and_linked(workouts: TonalWorkouts, monkeypatch: pytest.MonkeyPatch) -> None:
+    user_id, record_id = uuid4(), uuid4()
+    history = [
+        {"workoutActivityId": "act-1", "upper": 1906, "lower": 866, "core": 718, "overall": 1230,
+         "activityTime": "2026-10-23T10:27:06-07:00"},
+        {"workoutActivityId": "old", "upper": 1, "lower": 1, "core": 1, "overall": 1,
+         "activityTime": "2025-01-01T10:00:00-08:00"},
+    ]  # fmt: skip
+    monkeypatch.setattr(workouts, "_make_api_request", lambda *a, **k: history)
+    monkeypatch.setattr(workouts, "_tonal_user_id", lambda db, user_id: "tonal-user")
+
+    scores = workouts._strength_scores(
+        MagicMock(), user_id, START - timedelta(days=1), START + timedelta(days=1), {"act-1": record_id}
+    )
+
+    assert len(scores) == 1
+    score = scores[0]
+    assert score.category == HealthScoreCategory.STRENGTH
+    assert score.provider == ProviderName.TONAL
+    assert score.value == 123.0
+    assert score.qualifier == "x10"
+    assert score.components["overall"].value == 1230
+    assert score.components["upper"].value == 1906
+    assert score.zone_offset == "-07:00"
+    assert score.event_record_id == record_id
