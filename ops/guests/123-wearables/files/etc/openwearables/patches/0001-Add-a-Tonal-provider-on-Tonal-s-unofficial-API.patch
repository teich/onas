diff --git a/backend/app/services/providers/tonal/connect.py b/backend/app/services/providers/tonal/connect.py
new file mode 100644
index 00000000..a60540fe
--- /dev/null
+++ b/backend/app/services/providers/tonal/connect.py
@@ -0,0 +1,46 @@
+"""Connect an Open Wearables user to Tonal, once, from a terminal.
+
+    docker exec -it openwearables-app-1 python -m app.services.providers.tonal.connect <ow-user-id> [--days N]
+
+Asks for the Tonal email and the password (or, with an empty password, an emailed
+code). Only the tokens are stored; the password is never saved. With --days, also
+queues a historical sync of that many days.
+"""
+
+import argparse
+import getpass
+from uuid import UUID
+
+from app.database import SessionLocal
+from app.services.providers.tonal.strategy import TonalStrategy
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("user_id", type=UUID, help="Open Wearables user id")
+    parser.add_argument("--days", type=int, default=0, help="queue a historical sync of this many days")
+    args = parser.parse_args()
+
+    strategy = TonalStrategy()
+    oauth = strategy.oauth
+    email = input("Tonal email: ").strip()
+    password = getpass.getpass("Tonal password (leave empty to get an email code instead): ")
+    if password:
+        token_response = oauth.password_grant(email, password)
+    else:
+        oauth.send_email_code(email)
+        token_response = oauth.email_code_grant(email, input("Code from the email: ").strip())
+
+    with SessionLocal() as db:
+        if not strategy.user_repo.get(db, args.user_id):
+            raise SystemExit(f"No Open Wearables user {args.user_id}")
+        tonal_user_id = oauth.save_connection(db, args.user_id, token_response)
+    print(f"Connected Tonal user {tonal_user_id} to {args.user_id}.")
+
+    if args.days:
+        result = strategy.start_historical_sync(args.user_id, args.days)
+        print(result.message)
+
+
+if __name__ == "__main__":
+    main()
