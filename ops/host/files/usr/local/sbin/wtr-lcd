#!/usr/bin/python3
# Drive WTR's front LCD (the AOOSTAR WTR MAX's 960 x 376 panel) with live status. Managed in onas
# ops/host; see ops/host/README.md.
#
# Once a second: fetch the frame onas draws (GET /api/lcd/frame, 240 x 94 RGB, the same drawLcd()
# as the Machine view), draw each dot as a 3 x 3 pixel square with a 1-pixel gap, and send the
# panel only the parts that changed. When onas doesn't answer, draw a smaller panel from local
# sensors with the reason in the footer, so the screen never freezes on old numbers.
#
# The panel is a Synwit MCU on USB (0416:90a1, cdc_acm). Protocol as reverse-engineered by
# github.com/zehnm/aoostar-rs (docs/lcd_protocol.md) from the vendor's Windows app: 8-byte on/off
# commands, and an image as 47-byte RGB565 chunks, each with its byte offset. The panel answers 'A'.
#
#   wtr-lcd            run (the service)
#   wtr-lcd --once     draw one frame and exit
#   wtr-lcd --off      switch the panel off; --on switches it back on, showing the last image
#
# Python standard library only. Writes its state to $WTR_LCD_STATUS for ops/host/check.sh.
import os
import select
import signal
import struct
import subprocess
import sys
import termios
import time
import tty
import urllib.error
import urllib.request

DEVICE = os.environ.get('WTR_LCD_DEVICE', '/dev/serial/by-id/usb-Synwit_USB_Virtual_COM-if00')
FRAME_URL = os.environ.get('WTR_LCD_FRAME_URL', 'http://192.168.2.189:3000/api/lcd/frame')
STATUS_FILE = os.environ.get('WTR_LCD_STATUS', '/run/wtr-lcd/status')

COLS, ROWS, DOT = 240, 94, 4             # the dot grid; 4 pixels per dot fills the panel exactly
WIDTH, HEIGHT = COLS * DOT, ROWS * DOT   # 960 x 376
FRAME_BYTES = COLS * ROWS * 3
FAILS_BEFORE_FALLBACK = 3                # a hiccup keeps the last frame; three misses in a row don't

# ---------- the panel ----------

MAGIC = b'\xaa\x55\xaa\x55'
CMD_ON = MAGIC + b'\x0b\x00\x00\x00'
CMD_OFF = MAGIC + b'\x0a\x00\x00\x00'
IMG_START = MAGIC + b'\x05\x00\x00\x00\x04\x00\x0f\x2f\x00\x04\x0b\x00'
IMG_CHUNK = MAGIC + b'\x08\x00\x00\x00'
IMG_END = MAGIC + b'\x06\x00\x00\x00'
CHUNK = 47                               # bytes of pixels per message, as the vendor app sends


class PanelError(Exception):
    pass


class Panel:
    def __init__(self, device):
        self.fd = os.open(device, os.O_RDWR | os.O_NOCTTY)
        tty.setraw(self.fd)
        attrs = termios.tcgetattr(self.fd)
        attrs[2] |= termios.CLOCAL | termios.CREAD
        attrs[4] = attrs[5] = termios.B1500000  # nominal; USB CDC ignores it
        termios.tcsetattr(self.fd, termios.TCSANOW, attrs)
        termios.tcflush(self.fd, termios.TCIOFLUSH)
        self.shown = None                     # the RGB565 frame the panel has, for partial updates

    def close(self):
        os.close(self.fd)

    # One message per write, drained before the next, as aoostar-rs does: the firmware may expect
    # each message in its own USB transfer.
    def _send(self, data):
        view = memoryview(data)
        while view:
            view = view[os.write(self.fd, view):]
        termios.tcdrain(self.fd)

    def _acked(self, timeout):
        deadline = time.monotonic() + timeout
        got = b''
        while b'A' not in got:
            left = deadline - time.monotonic()
            if left <= 0 or not select.select([self.fd], [], [], left)[0]:
                return False
            got += os.read(self.fd, 64)
        return True

    def command(self, cmd):
        termios.tcflush(self.fd, termios.TCIFLUSH)
        self._send(cmd)
        if not self._acked(2.0):
            raise PanelError('no reply to command')

    # Send the chunks of `frame` (RGB565, little-endian) that differ from what the panel shows.
    # Returns the number of chunks sent.
    def show(self, frame):
        old = self.shown
        changed = [o for o in range(0, len(frame), CHUNK) if old is None or frame[o:o + CHUNK] != old[o:o + CHUNK]]
        if not changed:
            return 0
        termios.tcflush(self.fd, termios.TCIFLUSH)
        self.shown = None  # unknown until the panel confirms
        self._send(IMG_START)
        for o in changed:
            self._send(IMG_CHUNK + struct.pack('<I', o) + frame[o:o + CHUNK])
        self._send(IMG_END)
        if not self._acked(2.0):
            raise PanelError('no reply to image')
        self.shown = frame
        return len(changed)


# 240 x 94 RGB888 -> 960 x 376 RGB565: each dot a 3 x 3 square, black between dots.
def expand(rgb):
    gap = b'\x00\x00'
    dots = {}
    blank = gap * WIDTH
    lines = []
    for y in range(ROWS):
        row = rgb[y * COLS * 3:(y + 1) * COLS * 3]
        parts = []
        for x in range(0, COLS * 3, 3):
            key = row[x:x + 3]
            dot = dots.get(key)
            if dot is None:
                r, g, b = key
                px = (((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3)).to_bytes(2, 'little')
                dot = dots[key] = px * 3 + gap
            parts.append(dot)
        line = b''.join(parts)
        lines.append(line * 3 + blank)
    return b''.join(lines)


# ---------- the fallback panel, drawn here ----------
# The look of client/src/lib/lcd.ts (its palette, fonts and meters), with only what WTR can read
# by itself. The fonts and colours are copied from there; keep them in step.

