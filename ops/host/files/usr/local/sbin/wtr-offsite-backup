#!/bin/sh
# Back up the WTR data that guest backups skip (bind mounts) to the b2-offsite
# PBS datastore, encrypted with the same key as the guest backups.
# Managed in onas ops/host. Run by wtr-offsite-backup.timer.
#
# One backup group per dataset (host/wtr-<name>), so a failure partway through
# only costs that dataset: the others keep their own last snapshot, and metadata
# change detection only works from a previous completed snapshot of the same group.
set -u

# PBS_REPOSITORY, PBS_FINGERPRINT and PBS_PASSWORD (API token wtr-host@pbs!offsite).
# Root-only, created on WTR, not in ops.
set -a
. /etc/wtr-offsite-backup.env
set +a

failed=
backup() { # backup <name> <path>
	echo "== $1 ($2)"
	proxmox-backup-client backup "$1.pxar:$2" \
		--backup-type host --backup-id "wtr-$1" \
		--keyfile /etc/pve/priv/storage/pbs-lxc.enc \
		--change-detection-mode metadata \
		|| failed="$failed $1"
}

# Order matters on a slow uplink: small and irreplaceable first, videos last.
backup apps /fast/apps
backup aac /bulk/backups/AAC
backup photos /bulk/photos
backup cadillac /bulk/backups/Cadillac
backup m1-laptop /bulk/backups/m1-laptop
backup videos /bulk/videos

[ -z "$failed" ] || { echo "failed:$failed" >&2; exit 1; }
